<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="360dp"
    android:height="480dp"
    android:viewportWidth="360"
    android:viewportHeight="480">

    <!-- Ola asimétrica: profunda a la izquierda, elevándose hacia la derecha.
         Relleno con el mismo degradado cósmico del resto de la app. -->
    <path android:pathData="M0,150 C90,30 220,130 360,0 L360,480 L0,480 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endColor="@color/child_bg_bottom"
                android:endX="180"
                android:endY="480"
                android:startColor="@color/child_bg_top"
                android:startX="180"
                android:startY="0"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>

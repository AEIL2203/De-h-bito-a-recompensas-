<?xml version="1.0" encoding="utf-8"?>
<!--
    Chip con brillo: halo radial blanco sobre un fondo que se colorea con
    android:backgroundTint (el tint multiplica, así el halo toma el color del chip).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:centerX="0.5"
                android:centerY="0.3"
                android:endColor="#59FFFFFF"
                android:gradientRadius="90dp"
                android:startColor="#FFFFFFFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- Panel héroe de las pantallas de acceso: degradado violeta con halo cian -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="300"
                android:endColor="@color/auth_hero_end"
                android:startColor="@color/auth_hero_start"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.85"
                android:centerY="0.15"
                android:endColor="@android:color/transparent"
                android:gradientRadius="260dp"
                android:startColor="@color/child_tint_cyan"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.1"
                android:centerY="0.75"
                android:endColor="@android:color/transparent"
                android:gradientRadius="220dp"
                android:startColor="#40FF6B88"
                android:type="radial" />
        </shape>
    </item>
</layer-list>

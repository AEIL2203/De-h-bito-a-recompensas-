<?xml version="1.0" encoding="utf-8"?>
<!-- Splash: degradado radial violeta sobre fondo cósmico -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0F0A1C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.45"
                android:endColor="#000F0A1C"
                android:gradientRadius="420dp"
                android:startColor="#FF3B1E6B"
                android:type="radial" />
        </shape>
    </item>
</layer-list>

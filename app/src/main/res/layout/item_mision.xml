<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Game.Card.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp">

        <!-- Category icon in colorful bubble -->
        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/ivCategoria"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/circle_game_blue"
            android:elevation="4dp"
            app:iiv_color="@color/game_blue_dark"
            app:iiv_icon="gmr-school"
            app:iiv_size="36dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Mission name -->
        <TextView
            android:id="@+id/tvNombreMision"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-rounded"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/game_text_dark"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvXp"
            app:layout_constraintStart_toEndOf="@id/ivCategoria"
            app:layout_constraintTop_toTopOf="@id/ivCategoria" />

        <!-- Category label -->
        <TextView
            android:id="@+id/tvCategoria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/badge_category"
            android:fontFamily="sans-serif-rounded"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/game_purple_dark"
            app:layout_constraintEnd_toStartOf="@id/tvXp"
            app:layout_constraintStart_toEndOf="@id/ivCategoria"
            app:layout_constraintTop_toBottomOf="@id/tvNombreMision" />

        <!-- XP badge -->
        <TextView
            android:id="@+id/tvXp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_xp"
            android:fontFamily="sans-serif-rounded"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/game_yellow_dark"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Due date label -->
        <TextView
            android:id="@+id/tvFechaLimite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-rounded"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/game_text_medium"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/tvXp"
            app:layout_constraintStart_toEndOf="@id/ivCategoria"
            app:layout_constraintTop_toBottomOf="@id/tvCategoria" />

        <!-- Status chip -->
        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-rounded"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/ivCategoria"
            app:layout_constraintTop_toBottomOf="@id/tvFechaLimite" />

        <!-- Evidence thumbnail -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivEvidencia"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvXp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Game.Rounded12" />

        <!-- Complete button - 3D green -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompletar"
            style="@style/Widget.Game.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/mission_i_did_it"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEstado" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

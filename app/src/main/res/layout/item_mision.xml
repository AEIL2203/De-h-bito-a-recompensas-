<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Habitos.Child.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Izquierda: insignia de categoría -->
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivCategoria"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle"
                android:padding="13dp"
                app:iiv_icon="gmr-school" />

            <!-- Centro: detalles y badges -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNombreMision"
                        style="@style/Widget.Habitos.Text.TitleMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="Leer 15 minutos" />

                    <TextView
                        android:id="@+id/tvXp"
                        style="@style/Widget.Habitos.Text.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/child_tint_gold"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/neon_gold"
                        tools:text="+10 XP" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCategoria"
                    style="@style/Widget.Habitos.Text.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/child_tint_violet"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/neon_violet"
                    tools:text="Académica" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvEstado"
                        style="@style/Widget.Habitos.Text.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Pendiente" />

                    <TextView
                        android:id="@+id/tvFechaLimite"
                        style="@style/Widget.Habitos.Text.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:visibility="gone"
                        tools:text="⚠ Atrasada · 12/10"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>

            <!-- Miniatura de la evidencia enviada -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivEvidencia"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Game.Rounded12" />
        </LinearLayout>

        <!-- Abajo: CTA principal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompletar"
            style="@style/Widget.Habitos.Child.Button.Glow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/mission_i_did_it"
            app:icon="@drawable/ic_check_small"
            app:iconGravity="textStart"
            app:iconSize="20dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

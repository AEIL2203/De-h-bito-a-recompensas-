<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Habitos.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/pill_press">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Avatar con anillo de progreso hacia el siguiente nivel -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progresoNivel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                app:indicatorColor="?attr/colorPrimary"
                app:indicatorInset="0dp"
                app:indicatorSize="64dp"
                app:trackColor="?attr/colorSurfaceContainer"
                app:trackCornerRadius="3dp"
                app:trackThickness="4dp"
                tools:progress="60" />

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle"
                android:backgroundTint="?attr/colorPrimaryContainer"
                android:contentDescription="Avatar"
                android:padding="7dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombre"
                style="@style/Widget.Habitos.Text.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Mateo" />

            <TextView
                android:id="@+id/tvEdad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="8 años · 340 XP" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNivel"
                    style="@style/Widget.Habitos.Text.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/colorPrimaryContainer"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    tools:text="Nivel 4" />

                <TextView
                    android:id="@+id/tvEstrellasNino"
                    style="@style/Widget.Habitos.Text.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/tutor_icon_amber_bg"
                    android:textColor="@color/tutor_icon_amber"
                    tools:text="🪙 12" />

                <TextView
                    android:id="@+id/tvRachaNino"
                    style="@style/Widget.Habitos.Text.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/tutor_icon_pink_bg"
                    android:textColor="@color/tutor_icon_pink"
                    tools:text="🔥 3" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

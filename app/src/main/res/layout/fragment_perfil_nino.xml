<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/bottom_nav_padding"
    android:theme="@style/ThemeOverlay.Habitos.Child">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <TextView
            style="@style/Widget.Habitos.Text.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/child_profile_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface" />

        <!-- Avatar interactivo con insignia de edición -->
        <FrameLayout
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:layout_marginTop="20dp">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="116dp"
                android:layout_height="116dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_ring_neon"
                android:clickable="true"
                android:contentDescription="Avatar. Toca para cambiarlo"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:stateListAnimator="@animator/pill_press" />

            <com.mikepenz.iconics.view.IconicsImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/neon_green"
                android:duplicateParentState="false"
                android:elevation="4dp"
                android:importantForAccessibility="no"
                android:padding="8dp"
                app:iiv_color="@color/child_on_neon"
                app:iiv_icon="gmr-edit" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvNombre"
            style="@style/Widget.Habitos.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/child_profile_default_name" />

        <TextView
            android:id="@+id/tvProgreso"
            style="@style/Widget.Habitos.Text.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/child_tint_violet"
            android:text="@string/child_profile_level_xp"
            android:textColor="@color/neon_violet" />

        <TextView
            style="@style/Widget.Habitos.Text.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Toca el avatar para cambiarlo" />

        <TextView
            android:id="@+id/tvEligeAvatar"
            style="@style/Widget.Habitos.Text.TitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/child_profile_choose_avatar"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAvatares"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:visibility="gone" />

        <!-- Ajustes -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Habitos.Child.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <com.mikepenz.iconics.view.IconicsImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/child_tint_cyan"
                        android:padding="10dp"
                        app:iiv_color="@color/neon_cyan"
                        app:iiv_icon="gmr-brightness-3" />

                    <TextView
                        style="@style/Widget.Habitos.Text.TitleMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/child_profile_dark_mode" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchModoOscuro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="70dp"
                    android:background="@color/child_stroke" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <com.mikepenz.iconics.view.IconicsImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/child_tint_violet"
                        android:padding="10dp"
                        app:iiv_color="@color/neon_violet"
                        app:iiv_icon="gmr-music-note" />

                    <TextView
                        style="@style/Widget.Habitos.Text.TitleMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/child_profile_music" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchMusica"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="70dp"
                    android:background="@color/child_stroke" />

                <LinearLayout
                    android:id="@+id/btnVerTutorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <com.mikepenz.iconics.view.IconicsImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/child_tint_gold"
                        android:padding="10dp"
                        app:iiv_color="@color/neon_gold"
                        app:iiv_icon="gmr-help-outline" />

                    <TextView
                        style="@style/Widget.Habitos.Text.TitleMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Ver tutorial de nuevo" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

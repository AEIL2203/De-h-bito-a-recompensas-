<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/child_bg_bottom"
    android:theme="@style/ThemeOverlay.Habitos.Child">

    <!-- Panel héroe que ocupa la parte superior -->
    <View
        android:id="@+id/viewHero"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_login_hero"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.56"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo de la app y título -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:elevation="2dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/viewHero"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/viewHero"
        app:layout_constraintVertical_bias="0.36">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:outlineAmbientShadowColor="@color/neon_violet"
            android:outlineSpotShadowColor="@color/neon_violet"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="32dp"
            app:cardElevation="12dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.Habitos.Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.02"
            android:text="¡Bienvenido!"
            android:textColor="@color/auth_on_hero" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-rounded"
            android:text="De Hábitos a Recompensas"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/auth_on_hero_variant" />
    </LinearLayout>

    <!-- Panel inferior con borde superior de ola orgánica -->
    <LinearLayout
        android:id="@+id/panelAcceso"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-180dp"
        android:background="@drawable/bg_login_sheet"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="108dp"
        android:paddingEnd="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewHero">

        <TextView
            style="@style/Widget.Habitos.Text.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acceso seguro" />

        <TextView
            style="@style/Widget.Habitos.Text.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Tu cuenta se crea automáticamente al entrar por primera vez"
            android:textAlignment="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogle"
            style="@style/Widget.Habitos.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/white"
            android:elevation="6dp"
            android:outlineAmbientShadowColor="@color/neon_violet"
            android:outlineSpotShadowColor="@color/neon_violet"
            android:text="@string/login_tutor_google"
            android:textColor="#FF1F1F1F"
            app:icon="@drawable/ic_google_g"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/neon_violet"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVersion"
        style="@style/Widget.Habitos.Text.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:alpha="0.6"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Versión 1.0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>

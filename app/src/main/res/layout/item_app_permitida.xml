<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Habitos.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivIcono"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="Icono"
            android:scaleType="fitCenter"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Game.Rounded12" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombre"
                style="@style/Widget.Habitos.Text.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Clash Royale" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="4dp">

                <TextView
                    android:id="@+id/tvPrecio15"
                    style="@style/Widget.Habitos.Text.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/colorPrimaryContainer"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    tools:text="15m · 5🪙" />

                <TextView
                    android:id="@+id/tvPrecio30"
                    style="@style/Widget.Habitos.Text.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="?attr/colorPrimaryContainer"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    tools:text="30m · 10🪙" />

                <TextView
                    android:id="@+id/tvPrecio60"
                    style="@style/Widget.Habitos.Text.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="?attr/colorPrimaryContainer"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    tools:text="60m · 15🪙" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <com.mikepenz.iconics.view.IconicsImageView
            android:id="@+id/btnEliminar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="?attr/colorErrorContainer"
            android:contentDescription="Eliminar"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            app:iiv_color="@color/md_theme_onErrorContainer"
            app:iiv_icon="gmr-delete" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

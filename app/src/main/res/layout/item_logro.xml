<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Habitos.Child.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="22dp">

    <LinearLayout
        android:id="@+id/contenidoLogro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="84dp"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <FrameLayout
                android:id="@+id/fondoIcono"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center">

                <com.mikepenz.iconics.view.IconicsImageView
                    android:id="@+id/ivIcono"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    app:iiv_icon="gmr-star" />
            </FrameLayout>

            <!-- Candado sobre fondo circular (solo bloqueados) -->
            <com.mikepenz.iconics.view.IconicsImageView
                android:id="@+id/ivCandado"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/child_primary_container"
                android:elevation="2dp"
                android:padding="4dp"
                app:iiv_icon="gmr-lock" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombre"
                style="@style/Widget.Habitos.Text.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Primer paso" />

            <TextView
                android:id="@+id/tvDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Valida tu primera misión" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progresoLogro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    app:trackColor="@color/child_track"
                    app:trackCornerRadius="4dp"
                    app:trackStopIndicatorSize="0dp"
                    app:trackThickness="8dp" />

                <TextView
                    android:id="@+id/tvProgreso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-rounded"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="1/5" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

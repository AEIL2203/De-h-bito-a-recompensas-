<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:theme="@style/ThemeOverlay.Habitos.Child">

    <TextView
        android:id="@+id/tvTituloMisiones"
        style="@style/Widget.Habitos.Text.Headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/missions_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtituloMisiones"
        style="@style/Widget.Habitos.Text.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Completa misiones y gana XP"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloMisiones" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMisiones"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/bottom_nav_padding"
        app:layout_constraintBottom_toTopOf="@id/containerPaginacion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtituloMisiones"
        tools:listitem="@layout/item_mision" />

    <!-- Paginación: queda por encima de la barra de navegación flotante -->
    <LinearLayout
        android:id="@+id/containerPaginacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="92dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPaginaAnterior"
            style="@style/Widget.Habitos.Button.TonalPrimary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:text="@string/missions_previous" />

        <TextView
            android:id="@+id/tvPagina"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-rounded"
            android:gravity="center"
            android:text="@string/missions_page_indicator"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPaginaSiguiente"
            style="@style/Widget.Habitos.Button.TonalPrimary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:text="@string/missions_next" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSinMisiones"
        style="@style/Widget.Habitos.Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/missions_empty"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtituloMisiones" />

</androidx.constraintlayout.widget.ConstraintLayout>
